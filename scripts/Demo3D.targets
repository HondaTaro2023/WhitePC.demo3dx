<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <OutputType>Library</OutputType>
    <LangVersion>14.0</LangVersion>
    <OutputPath>.\.build\bin\</OutputPath>
    <AssemblySearchPaths>
      C:\Program Files (x86)\Emulate3D 2026;
      $(AssemblySearchPaths);
    </AssemblySearchPaths>

    <NoWarn>
      CA1416; <!--x is only supported on: 'windows'-->
    </NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="C:\Program Files (x86)\Emulate3D 2026\Emulate3D.SourceGenerators.dll"/>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Demo3D.AspectLibrary">
      <Private>False</Private>
      <ImplicitlyAdded>True</ImplicitlyAdded>
    </Reference>
    <Reference Include="Demo3D.Common">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.Xml">
      <Private>False</Private>
      <ImplicitlyAdded>True</ImplicitlyAdded>
    </Reference>
    <Reference Include="Demo3D.Async">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.Core">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.EventQueue">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.Time">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.Licensing">
      <Private>False</Private>
    </Reference>
    <Reference Include="SmartEdit">
      <Private>False</Private>
    </Reference>
    <Reference Include="WpfControls">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.Raw">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.IO">
      <Private>False</Private>
    </Reference>
    <Reference Include="PLC">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.HLE">
      <Private>False</Private>
      <ImplicitlyAdded>True</ImplicitlyAdded>
    </Reference>
    <Reference Include="CT.CIPIO">
      <Private>False</Private>
    </Reference>
    <Reference Include="HtmlAgilityPack">
      <Private>False</Private>
    </Reference>
    <Reference Include="Demo3D.Renderers.Common">
      <Private>False</Private>
    </Reference>
    <Reference Include="Emulate3DMesh.NET">
      <Private>False</Private>
    </Reference>
    <Reference Include="Emulate3D.FMI">
      <Private>False</Private>
    </Reference>
    <Reference Include="Emulate3D.SourceGenerators">
      <Private>False</Private>
    </Reference>
    <Reference Include="Emulate3D.WebApp">
      <Private>False</Private>
    </Reference>
    <Reference Include="MessagePack">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>